# Kopieer naar .env en vul je eigen Supabase-project in.
# Vind deze in Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://JOUW-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=JOUW-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=

# Optioneel — crash-/foutmonitoring (Sentry, INF-4). Leeg laten = uit (no-op).
# Voor cloud-builds als EAS-secret zetten i.p.v. hier, zie docs/eas-setup.md.
# DSN = publieke client-waarde (Sentry: Project Settings -> Client Keys/DSN).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time-only — source-map-upload tijdens de EAS-build (Sentry: Settings -> Auth Tokens).
# NIET committen; zet 'm als EAS-env (sensitive). Leeg = upload wordt overgeslagen.
SENTRY_AUTH_TOKEN=
